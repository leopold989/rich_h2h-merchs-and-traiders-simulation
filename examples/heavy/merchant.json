{
  "schema_version": 1,
  "defaults": {
    "request_timeout_ms": 10000,
    "poll_after_create": {
      "enabled": true,
      "delay_ms": 2000,
      "attempts": 3,
      "interval_ms": 5000
    },
    "callback_response": {
      "status_code": 200,
      "body": {
        "success": true,
        "message": "accepted"
      }
    },
    "external_id": {
      "mode": "pattern",
      "pattern": "{merchant_alias}-{template_id}-{date:%Y%m%d%H%M%S}-{seq}"
    }
  },
  "request_templates": [
    {
      "id": "light_rub_sbp",
      "active": true,
      "description": "Light профиль: один простой RUB/SBP запрос",
      "request": {
        "amount": 5000,
        "payment_gateway": "sbp_rub",
        "payment_detail_type": "phone",
        "is_transgran": false
      },
      "post_actions": []
    },
    {
      "id": "heavy_card_cancel",
      "active": true,
      "description": "Heavy профиль: card запрос с отменой",
      "request": {
        "amount": 25000,
        "payment_gateway": "sberbank_rub",
        "payment_detail_type": "card",
        "is_transgran": false
      },
      "post_actions": [
        {
          "id": "cancel_30s",
          "active": true,
          "type": "cancel",
          "after_ms": 30000,
          "if_order_status_in": [
            "pending"
          ]
        }
      ]
    },
    {
      "id": "heavy_kzt_dispute",
      "active": true,
      "description": "Heavy профиль: KZT сценарий со спором",
      "request": {
        "amount": 150000,
        "payment_gateway": "halyk_kzt",
        "payment_detail_type": "card",
        "is_transgran": true
      },
      "post_actions": [
        {
          "id": "dispute_90s",
          "active": true,
          "type": "dispute",
          "after_ms": 90000,
          "if_order_status_in": [
            "pending"
          ],
          "receipt": {
            "kind": "file",
            "path": "receipts/dispute_halyk_001.pdf"
          }
        }
      ]
    }
  ],
  "merchants": [
    {
      "alias": "merchant_light",
      "active": true,
      "merchant_id": "8bc8a8d0-77e2-4ff5-9ff6-b9b74fd51a11",
      "access_token": "merchant-light-token",
      "target": {
        "base_url": "https://platform-rich-dev.local",
        "api_prefix": "/api/h2h",
        "verify_ssl": false,
        "timeout_ms": 10000
      },
      "callback": {
        "enabled": true,
        "path": "/callbacks/merchants/merchant_light",
        "validate_access_token": true,
        "response_status_code": 200,
        "response_body": {
          "success": true,
          "message": "callback accepted"
        }
      },
      "default_headers": {
        "X-Sim-Merchant": "merchant_light"
      }
    },
    {
      "alias": "merchant_load_2",
      "active": true,
      "merchant_id": "1c509b81-c1df-4533-a62f-a8ba7fc53e22",
      "access_token": "merchant-load-2-token",
      "target": {
        "base_url": "https://platform-rich-dev.local",
        "api_prefix": "/api/h2h",
        "verify_ssl": false,
        "timeout_ms": 10000
      },
      "callback": {
        "enabled": true,
        "path": "/callbacks/merchants/merchant_load_2",
        "validate_access_token": true,
        "response_status_code": 200,
        "response_body": {
          "success": true,
          "message": "callback accepted"
        }
      },
      "default_headers": {
        "X-Sim-Merchant": "merchant_load_2"
      }
    },
    {
      "alias": "merchant_load_3",
      "active": true,
      "merchant_id": "2c509b81-c1df-4533-a62f-a8ba7fc53e23",
      "access_token": "merchant-load-3-token",
      "target": {
        "base_url": "https://platform-rich-dev.local",
        "api_prefix": "/api/h2h",
        "verify_ssl": false,
        "timeout_ms": 10000
      },
      "callback": {
        "enabled": true,
        "path": "/callbacks/merchants/merchant_load_3",
        "validate_access_token": true,
        "response_status_code": 200,
        "response_body": {
          "success": true,
          "message": "callback accepted"
        }
      },
      "default_headers": {
        "X-Sim-Merchant": "merchant_load_3"
      }
    }
  ],
  "merchant_jobs": [
    {
      "id": "merchant_light_job",
      "active": true,
      "merchant_alias": "merchant_light",
      "template_id": "light_rub_sbp",
      "schedule": {
        "start_delay_sec": 5,
        "interval_sec": 60,
        "requests_total": 10,
        "jitter_sec": 0,
        "max_inflight": 1
      },
      "external_id": {
        "pattern": "light-{date:%Y%m%d}-{seq}"
      }
    },
    {
      "id": "merchant_load_2_sbp_burst",
      "active": true,
      "merchant_alias": "merchant_load_2",
      "template_id": "light_rub_sbp",
      "schedule": {
        "start_delay_sec": 0,
        "interval_sec": 5,
        "requests_total": 100,
        "jitter_sec": 1,
        "max_inflight": 5
      },
      "external_id": {
        "pattern": "load2-sbp-{date:%Y%m%d}-{seq}"
      }
    },
    {
      "id": "merchant_load_2_card_burst",
      "active": true,
      "merchant_alias": "merchant_load_2",
      "template_id": "heavy_card_cancel",
      "schedule": {
        "start_delay_sec": 10,
        "interval_sec": 3,
        "requests_total": 80,
        "jitter_sec": 1,
        "max_inflight": 5
      },
      "external_id": {
        "pattern": "load2-card-{date:%Y%m%d}-{seq}"
      }
    },
    {
      "id": "merchant_load_3_kzt",
      "active": true,
      "merchant_alias": "merchant_load_3",
      "template_id": "heavy_kzt_dispute",
      "schedule": {
        "start_delay_sec": 20,
        "interval_sec": 15,
        "requests_total": 50,
        "jitter_sec": 2,
        "max_inflight": 2
      },
      "external_id": {
        "pattern": "load3-kzt-{date:%Y%m%d}-{seq}"
      }
    }
  ]
}
