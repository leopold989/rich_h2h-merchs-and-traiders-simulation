{
  "schema_version": 1,
  "defaults": {
    "driver": "standard_h2h",
    "api_prefix": "/api/h2h",
    "validate_access_token": true,
    "validate_merchant_id": true,
    "selection_strategy": "first_match",
    "idempotency": {
      "key_fields": [
        "merchant_id",
        "external_id"
      ],
      "ttl_sec": 86400
    },
    "callback_client": {
      "timeout_ms": 10000,
      "verify_ssl": false,
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      }
    }
  },
