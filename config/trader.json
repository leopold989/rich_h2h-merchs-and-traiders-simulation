{
  "schema_version": 1,
  "defaults": {
    "driver": "standard_h2h",
    "api_prefix": "/api/h2h",
    "validate_access_token": true,
    "validate_merchant_id": true,
    "selection_strategy": "first_match",
    "idempotency": {
      "key_fields": [
        "merchant_id",
        "external_id"
      ],
      "ttl_sec": 86400
    },
    "callback_client": {
      "timeout_ms": 10000,
      "verify_ssl": false,
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      }
    }
  },
  "response_profiles": [
    {
      "id": "instant_success",
      "active": true,
      "create_order": {
        "mode": "success",
        "delay_ms": 300,
        "status_code": 200,
        "callback": {
          "enabled": false
        }
      },
      "cancel_order": {
        "mode": "success",
        "delay_ms": 100,
        "status_code": 200
      },
      "confirm_client": {
        "mode": "success",
        "delay_ms": 100,
        "status_code": 200
      },
      "add_receipt": {
        "mode": "success",
        "delay_ms": 100,
        "status_code": 200
      },
      "open_dispute": {
        "mode": "success",
        "delay_ms": 100,
        "status_code": 200
      }
    }
  ],
  "traders": [
    {
      "alias": "trader_light",
      "active": true,
      "base_path": "/traders/trader_light",
      "driver": "standard_h2h",
      "auth": {
        "access_token": "trader-light-token",
        "merchant_id": "c0a0c1fd-37ad-4c9e-8a48-7b4c90c1f111",
        "validate_access_token": true,
        "validate_merchant_id": true
      },
      "selection_strategy": "first_match",
      "default_response_profile_id": "instant_success",
      "routing_rules": [
        {
          "id": "rule_light_sbp",
          "active": true,
          "match": {
            "payment_gateway": "sbp_rub",
            "payment_detail_type": "phone",
            "amount": {
              "gte": 1000,
              "lte": 15000
            },
            "is_transgran": false
          },
          "requisite_pool": [
            "req_light_phone_01"
          ],
          "response_profile_id": "instant_success"
        }
      ],
      "requisites": [
        {
          "id": "req_light_phone_01",
          "active": true,
          "payment_gateway": "sbp_rub",
          "detail_type": "phone",
          "detail": "+79990001122",
          "initials": "IVANOV I I",
          "bank_name": "СБП",
          "amount_range": {
            "min": 1000,
            "max": 15000
          },
          "is_transgran": false,
          "priority": 10,
          "daily_limit": null
        }
      ]
    }
  ]
}
